# VS Code Python Debugger loads .env. Leave unset for the memory-only server.
GANADA_DB_HOST=127.0.0.1
GANADA_DB_PORT=3306
GANADA_DB_NAME=ganada
GANADA_DB_USER=ganada_app
GANADA_DB_PASSWORD=

# Generate a Fernet key once and keep it outside Git. See README.md.
# GANADA_SOLAR_ENCRYPTION_KEY=
# GANADA_SOLAR_MODEL=solar-pro-4
# GANADA_DB_FILES_DIR=
